rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.uid == 'FC4QogHGgmgars0mbg9adE1Hx4N2';
    }
    // قراءة عامة لبيانات الموقع، والكتابة للمدير فقط
    match /videos/{id}           { allow read: if true; allow write: if isAdmin(); }
    match /videoCategories/{id}  { allow read: if true; allow write: if isAdmin(); }
    match /reviews/{id}          { allow read: if true; allow write: if isAdmin(); }
    match /socialIcons/{id}      { allow read: if true; allow write: if isAdmin(); }
    match /services/{id}         { allow read: if true; allow write: if isAdmin(); }
    match /settings/{id}         { allow read: if true; allow write: if isAdmin(); }
    match /social/{id}           { allow read: if true; allow write: if isAdmin(); }
    match /navigation/{id}       { allow read: if true; allow write: if isAdmin(); }
    // عدّاد الزيارات: الزائر يستطيع فقط زيادة العدّاد بمقدار 1، والمدير يقرأ ويدير
    match /visitsDaily/{day} {
      allow read: if isAdmin();
      allow create: if day.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
                    && request.resource.data.keys().hasOnly(['date','count'])
                    && request.resource.data.count == 1;
      allow update: if day.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
                    && request.resource.data.keys().hasOnly(['date','count'])
                    && request.resource.data.count == resource.data.count + 1;
      allow delete: if isAdmin();
    }
    match /meta/{id}             { allow read, write: if isAdmin(); }
  }
}
